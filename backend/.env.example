# Local development only. Generate a different strong SECRET_KEY for production.
SECRET_KEY=local-development-only-change-before-deployment-000000000000
DEBUG=True
OWNER_PREVIEW_MODE=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave unset locally to use backend/media and backend/private-media.
# Production: use directories on a persistent disk, never ephemeral storage.
# MEDIA_ROOT=/var/data/media
# PRIVATE_MEDIA_ROOT=/var/data/private-media

# Local emails print to the backend console; they are NOT delivered.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=AKEYA <orders@localhost>

# Optional: only required for customer account registration/password reset.
# Guest checkout and owner login do not use SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
